.animal-database { padding: 8px; }
.database-header { flex-direction: row; align-items: center; flex-shrink: 0; }
.database-selector { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.database-selector > .unity-base-field__label { min-width: 60px; width: 60px; }
.database-content { flex-grow: 1; min-height: 0; min-width: 0; }
.database-status { white-space: normal; margin-top: 4px; margin-bottom: 4px; }
.database-status-empty { display: none; }
.species-catalog { min-width: 130px; min-height: 0; overflow: hidden; padding-right: 6px; }
.species-search { min-width: 0; max-width: 100%; width: auto; flex-shrink: 1; align-self: stretch; margin-left: 0; margin-right: 0; }
.species-search .unity-text-input { min-width: 0; flex-shrink: 1; }
.species-actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 4px; margin-bottom: 4px; }
.species-list { flex-grow: 1; min-height: 0; min-width: 0; }
.species-row { overflow: hidden; text-overflow: ellipsis; }
.species-inspector { min-width: 160px; padding-left: 8px; padding-right: 4px; }
.species-inspector .unity-scroll-view__content-container { min-width: 0; }
.species-form-title { -unity-font-style: bold; margin-top: 4px; margin-bottom: 8px; }
.species-form-field { flex-direction: column; align-items: stretch; min-width: 0; margin-bottom: 8px; }
.species-form-field > .unity-base-field__label { min-width: 0; width: auto; white-space: normal; }
.species-form-actions { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
TwoPaneSplitView { flex-grow: 1; min-width: 0; min-height: 100px; }
Toolbar { flex-shrink: 0; margin-top: 6px; margin-bottom: 6px; }
